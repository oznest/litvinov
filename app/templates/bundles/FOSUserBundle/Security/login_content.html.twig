{% extends '@SonataAdmin/standard_layout.html.twig' %}
{% trans_default_domain 'FOSUserBundle' %}

{% block sonata_left_side %}
{% endblock %}

{% block sonata_top_nav_menu %}
{% endblock %}

{% block sonata_page_content %}
{% if error %}
    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
{% endif %}
    <style>
        .content-wrapper{
            margin-left: 0;
        }
    </style>
    <div class="container mt-5" style="max-width: 400px;">
        <h2 class="text-center mb-4">Login</h2>

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form action="{{ path('fos_user_security_check') }}" method="post">
            <div class="form-group col-md-12">
                <label for="username" class="control-label col-sm-3">Email</label>
                <div class="col-sm-9">
                    <input type="text" id="username" name="_username" value="{{ last_username }}" required="required" autocomplete="username" required autofocus/>
                </div>
            </div>

            <div class="form-group mt-10 col-md-12">
                <label for="password" class="control-label col-sm-3">Password</label>
                <div class="col-sm-9">
                    <input type="password" id="password" name="_password" required="required" autocomplete="current-password" />
                </div>
            </div>
            <div class="form-group mt-10 col-md-12">
                <div class="col-md-9"></div>
                <div class="col-md-3"><button type="submit" class="btn btn-primary w-100 mt-4">Login</button></div>

            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        </form>
    </div>
{% endblock %}