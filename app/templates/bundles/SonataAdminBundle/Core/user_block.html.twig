{% if app.user %}
    <span class="email">
        {{ app.user.email }}
    </span>
    |
    <a href="{{ path('fos_user_security_logout') }}">
        <i class="fa fa-sign-out"></i> Logout
    </a>
{% else %}
    <a href="{{ path('fos_user_security_login') }}">
        <i class="fa fa-sign-in"></i> Login
    </a>
{% endif %}